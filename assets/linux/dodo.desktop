[Desktop Entry]
Type=Application
Version=1.0
Name=dodo
GenericName=Developer Tools
Comment=A collection of small developer tools in one window
Exec=dodo
Icon=dodo
Terminal=false
Categories=Development;Utility;
Keywords=json;base64;jwt;http;api;docker;
# UNVERIFIED, like the rest of the Linux packaging: dodo has never been built or
# run on Linux. This must match the WM_CLASS the running window reports, which
# GPUI writes from WindowOptions::app_id - now set, to window_icon::APP_ID
# ("dodo"). A test in src/window_icon.rs fails if the two drift apart, and the
# same constant is the Wayland app_id a compositor matches this file's *name*
# against, so all three have to stay equal. If the task bar shows a generic icon
# next to a correct launcher icon, this line is still the first thing to check:
# `xprop WM_CLASS` on the running window.
StartupWMClass=dodo
StartupNotify=true
