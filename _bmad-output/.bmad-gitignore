# Files generated by BMAD workflows that should NOT be committed
# Apply by running: cat _bmad-output/.bmad-gitignore >> .gitignore

# Review & validation statuses (per-story YAML files)
_bmad-output/implementation-artifacts/review/*-review-status.yaml
_bmad-output/implementation-artifacts/validation/*-validation-status.yaml

# Personal customization (every developer has their own)
_bmad/custom/*.user.toml
_bmad/config.user.toml

# Sprint-change proposals are PRs, not commits
_bmad-output/implementation-artifacts/course-corrections/*-draft.md

# Session caches (if added later)
_bmad-output/.cache/
